# Connection settings for <CLIENT>
# -----------------------------------------------------------------------------
# 1. Copy this file to:  projects/<client>/.secrets/connection.env
# 2. Fill in the real values.
# 3. Lock it down:        chmod 600 projects/<client>/.secrets/connection.env
#
# ⚠️ NEVER commit this file to git. NEVER paste its contents into the chat.
#    The .secrets/ folder is git-ignored for exactly this reason.
# -----------------------------------------------------------------------------

# --- SSH / SFTP (the main way in) ---
SSH_HOST='000.000.000.000'        # server IP or hostname
SSH_PORT='22'                     # Kinsta uses a custom high port — find it in MyKinsta
SSH_USER='username'               # SSH/SFTP user
WP_PATH='/www/sitename/public'    # absolute path to the WordPress web root on the server

# --- WordPress REST API (optional; only for REST-based edits) ---
# Generate an Application Password in wp-admin → Users → (your user) → Application Passwords.
# This is NOT the normal login password — the login password does not work for the REST API.
WP_REST_USER='admin_login'
WP_REST_APP_PASSWORD='xxxx xxxx xxxx xxxx xxxx xxxx'

# --- Host / cache notes ---
HOST='kinsta'                     # kinsta | hostinger | cpanel | other
# How to clear cache for this host — see library/lessons/caching_by_host.md
# e.g. Kinsta WITH the MU plugin:  wp kinsta cache purge --all
#      Kinsta WITHOUT it:          MyKinsta dashboard → Tools → Clear Cache
