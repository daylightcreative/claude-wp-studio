{
  "model": "opus",
  "effortLevel": "xhigh",
  "hooks": {
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/tooling/save.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python3 tooling/catalog.py:*)",
      "Bash(./tooling/catalog.py:*)",
      "Bash(tooling/save.sh:*)",
      "Bash(tooling/maintain.sh:*)",
      "Bash(tooling/credentials.sh:*)",
      "Bash(git status:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git log:*)",
      "Bash(wp:*)",
      "Bash(php -l:*)"
    ]
  }
}
